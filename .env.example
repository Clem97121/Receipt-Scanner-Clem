BOT_TOKEN=your_telegram_bot_token_here

GEMINI_API_KEY=your_api_key

DATABASE_URL=postgresql+asyncpg://user:password@host:5432/dbname

# AWS resources (created by Terraform)
PHOTOS_BUCKET=receipt-scanner-photos
RECEIPTS_QUEUE_URL=https://sqs.eu-central-1.amazonaws.com/123456789012/receipt-scanner-receipts
AWS_DEFAULT_REGION=eu-central-1

# Telegram sends it in X-Telegram-Bot-Api-Secret-Token; must match the secret_token passed to setWebhook
WEBHOOK_SECRET=random_string_of_letters_digits_and_underscores

# On Lambda the secrets above are read from SSM Parameter Store under this prefix
# SSM_PARAMETER_PREFIX=/receipt-scanner

# Optional: timezone for "today"/"this month" and currency for manual expenses
# BOT_TIMEZONE=Europe/Prague
# DEFAULT_CURRENCY=CZK
